# ============================================================
# RISC-V Network Telemetry SoC — .gitignore
#
# VERSIONED (never ignored):
#   rtl/  tb/  scripts/  doc/  aes/  core/  README
#   run/  -> only *.f (filelists), *.csh (flows), *.tcl, *.rc
#            (Verdi signal groups)
#
# IGNORED: everything a tool generates (VCS/Verdi binaries, logs,
#   waveforms, GUI state), plus local archives and third-party
#   drop-ins whose sources are already vendored into rtl/.
#
# Rule of thumb: if you created it by hand and a fresh clone needs
#   it, it is NOT ignored. If a tool can rebuild it, it IS.
# ============================================================

# ------------------------------------------------------------
# 1. VCS / simulator build products (anywhere in the tree)
# ------------------------------------------------------------
simv
simv.*
simv.daidir/
simv.vdb/
csrc/
ucli.key
vc_hdrs.h
*.so
*.a
*.o
*_archive_*.so

# ------------------------------------------------------------
# 2. Simulation logs and reports
# ------------------------------------------------------------
*.log
*.log.*
verdi_config_file

# ------------------------------------------------------------
# 3. Waveforms, dumps and EDA GUI state
# ------------------------------------------------------------
*.fsdb
*.vpd
*.vcd
*.shm
*.trn
*.dsn
*.vdb
*.ses
*.ses.*
novas.conf
novas.rc
novas_dump.log
novas.*.log*
verdiLog/
DVEfiles/
dve_replay/
*.wlf
transcript

# ------------------------------------------------------------
# 4. Coverage / profiling databases
# ------------------------------------------------------------
urgReport/
urgReport.*
coverage/
cov_work/
work/
work_*/
INCA_libs/
xcelium.d/
.cm/
*.cm
*.sdb
*.db
*.dat
*.key

# ------------------------------------------------------------
# 5. run/ — simulation scratch area
#    Ignore everything, then re-include only flow assets.
#    (Keep the "re-ignore" block at the end: Verdi/VCS drop
#    novas.rc / verdi_config_file in run/ and they match *.rc.)
# ------------------------------------------------------------
run/*
!run/.gitkeep
!run/*.f
!run/*.csh
!run/*.tcl
!run/*.rc
run/novas.rc
run/verdi_config_file

# ------------------------------------------------------------
# 6. Software / firmware build products
#    NOTE: source files (main.c, linker.ld, *.c, *.h) are NEVER
#    ignored — only what the toolchain emits.
# ------------------------------------------------------------
*.elf
*.exe
*.out
*.bin
*.hex
*.lst
*.map
*.d
*.o.d
program.hex

# ------------------------------------------------------------
# 7. Archives and third-party drop-ins
#    Sources are vendored into rtl/, so archives/extracted trees
#    are local scratch only.
# ------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
aes.zip
axi-lite_uart-ipcore-develop/

# ------------------------------------------------------------
# 8. Generated docs / reports
# ------------------------------------------------------------
doc/generated/
reports/generated/
results/
artifacts/
*.aux
*.toc
*.synctex.gz

# ------------------------------------------------------------
# 9. Python / environment / editor / OS
# ------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
.env
.env.*
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.bak
*.orig
\#*\#
.\#*

# LibreOffice / Word lock + autosave files (e.g. doc/.~lock.X.docx#)
.~lock.*
\#*\#
*.docx#

# ------------------------------------------------------------
# 10. Scratch
# ------------------------------------------------------------
tmp/
temp/
scratch/
notes_private/
