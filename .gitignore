# ============================================================
# RISC-V Network Telemetry SoC — git ignore rules
#
# Principle: RTL, testbenches, docs, flow scripts and VCS filelists
# are versioned. Everything a tool generates (binaries, logs,
# waveforms, GUI state) is ignored.
# ============================================================

# ------------------------------------------------------------
# VCS build / run products (anywhere in the tree)
# ------------------------------------------------------------
simv
simv.*
simv.daidir/
simv.vdb/
csrc/
ucli.key
*.so
*.a
*.o
vc_hdrs.h
*_archive_*.so

# VCS / simulation logs and reports
*.log
vcs_run.log
sim_stdout.log
verdi_config_file

# Waveforms and dumps
*.fsdb
*.vpd
*.vcd
*.shm
*.trn
*.dsn
*.vdb
verdiLog/
novas.conf
novas.rc
novas_dump.log
novas.*.log*
*.ses
*.ses.config
*.ses.wave.*
*.ses.png
DVEfiles/
dve_replay/
urgReport/
urgReport.*
coverage/
cov_work/
work/
work_*/
INCA_libs/
xcelium.d/
.cm/
*.cm

# Coverage / profiling databases
*.sdb
*.db
*.dat
*.key

# ------------------------------------------------------------
# run/ — simulation scratch area
# Ignore everything EXCEPT the versioned flow assets below.
# (VCS filelists *.f already tracked stay tracked.)
# ------------------------------------------------------------
run/*
!run/.gitkeep
!run/*.f
!run/p[0-9]_*.csh
!run/p[0-9]_*.tcl
!run/p[0-9]_*.rc
!run/axi_wave.rc
!run/wave.rc

# ------------------------------------------------------------
# Software / C build products
# ------------------------------------------------------------
*.elf
*.exe
*.out
*.bin
*.hex.generated
*.lst
*.map
*.d
program.hex

# ------------------------------------------------------------
# Generated docs / reports
# ------------------------------------------------------------
doc/generated/
reports/generated/
results/
artifacts/
*.aux
*.toc
*.synctex.gz

# ------------------------------------------------------------
# Python / env / IDE / OS
# ------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
.env
.env.*
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.bak
*.orig
\#*\#
.\#*

# ------------------------------------------------------------
# Scratch
# ------------------------------------------------------------
tmp/
temp/
scratch/
notes_private/
main.c
test.c
